<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Feathered overlay: text remains crisp and art fades into the dark left edge. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#ED0B061A"
                android:centerColor="#B80B061A"
                android:endColor="#090B061A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F6080412"
                android:centerColor="#7A0B061A"
                android:endColor="#000B061A" />
        </shape>
    </item>
</layer-list>
