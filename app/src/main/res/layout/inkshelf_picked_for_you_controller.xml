<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inkshelf_pfy_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/inkshelf_pfy_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="860dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="@string/inkshelf_pfy_kicker"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:alpha="0.9"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/inkshelf_pfy_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.005"
                android:text="@string/inkshelf_pfy_title"
                android:textColor="?attr/colorOnBackground"
                android:textSize="30sp"
                android:textStyle="bold" />

            <View
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="20dp"
                android:text="@string/inkshelf_pfy_tagline"
                android:textColor="?attr/colorOnBackground"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:text="@string/inkshelf_pfy_intro_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inkshelf_pfy_refresh"
                style="@style/Widget.Tachiyomi.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Refresh Picks"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:cornerRadius="15dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:id="@+id/inkshelf_pfy_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inkshelf_pfy_see_more"
                style="@style/Widget.Tachiyomi.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/inkshelf_pfy_see_more"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:cornerRadius="15dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                tools:visibility="visible" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/inkshelf_pfy_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:text="@string/inkshelf_pfy_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="600dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
