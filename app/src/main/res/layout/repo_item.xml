<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="@dimen/material_component_lists_single_line_with_avatar_height"
    style="@style/Widget.Tachiyomi.CardView.Draggable">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/material_component_lists_single_line_with_avatar_height">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_store_button"
            style="?materialIconButtonStyle"
            app:iconTint="?attr/colorOnBackground"
            android:layout_width="54dp"
            android:layout_height="@dimen/material_component_lists_single_line_with_avatar_height"
            android:scaleType="center"
            android:contentDescription="@string/website"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:icon="@drawable/ic_open_in_webview_24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discord_button"
            style="?materialIconButtonStyle"
            app:iconTint="?attr/colorOnBackground"
            android:layout_width="54dp"
            android:layout_height="@dimen/material_component_lists_single_line_with_avatar_height"
            android:layout_marginEnd="4dp"
            android:scaleType="center"
            android:tooltipText="@string/discord"
            app:icon="@drawable/ic_discord_24dp"
            android:contentDescription="@string/discord"
            app:tint="?attr/colorOnBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/open_store_button"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_button"
            style="?materialIconButtonStyle"
            app:iconTint="?attr/colorOnBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            app:icon="@drawable/ic_edit_24dp"
            app:tint="@color/gray_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/edit_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/edit_button"
            app:layout_constraintBottom_toBottomOf="@id/edit_button"
            app:layout_constraintEnd_toEndOf="@id/edit_button"
            app:layout_constraintTop_toTopOf="@id/edit_button"
            tools:visibility="visible" />

        <eu.kanade.tachiyomi.widget.TachiyomiTextInputEditText
            android:id="@+id/edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:hint="@string/category"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorOnBackground"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/title"
            app:layout_constraintTop_toTopOf="@id/title"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="@id/title"
            tools:text="Title"
            android:autofillHints="" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center|start"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnBackground"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/edit_button"
            app:layout_constraintStart_toEndOf="@id/discord_button"
            tools:text="Title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
