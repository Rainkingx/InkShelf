<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browse_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/browse_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/background">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/browse_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="@dimen/inkshelf_discover_content_top_padding"
                android:paddingEnd="20dp"
                android:paddingBottom="120dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/discover_title_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/discover_title_kicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.14"
                        android:text="@string/inkshelf_discover_kicker"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/discover_menu_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/browse_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="12dp"
                        android:autoSizeMaxTextSize="30sp"
                        android:autoSizeMinTextSize="23sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:text="@string/modern_browse_heading"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/discover_menu_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/discover_title_kicker" />

                    <View
                        android:id="@+id/discover_title_underline"
                        android:layout_width="64dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/colorPrimary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/browse_heading" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/discover_menu_button"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/modern_browse_manage_sources"
                        android:minWidth="0dp"
                        android:padding="12dp"
                        app:icon="@drawable/ic_more_vert_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnBackground"
                        app:layout_constraintBottom_toBottomOf="@id/browse_heading"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/browse_heading" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/browse_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.78"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/inkshelf_discover_subtitle"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/browse_search_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:minHeight="64dp"
                    android:hint="@string/inkshelf_discover_search_hint"
                    app:boxCornerRadiusBottomEnd="22dp"
                    app:boxCornerRadiusBottomStart="22dp"
                    app:boxCornerRadiusTopEnd="22dp"
                    app:boxCornerRadiusTopStart="22dp"
                    app:boxStrokeColor="@color/inkshelf_search_outline"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconDrawable="@drawable/ic_search_24dp"
                    app:endIconMode="custom"
                    app:endIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/browse_search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/discover_search_helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.66"
                    android:includeFontPadding="false"
                    android:text="@string/inkshelf_discover_search_helper"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="12sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:includeFontPadding="false"
                    android:text="@string/inkshelf_quick_searches_title"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/quick_searches_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="7dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/popular_search_batman"
                            style="@style/Widget.Tachiyomi.Chip.Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/inkshelf_quick_search_batman" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/popular_search_spiderman"
                            style="@style/Widget.Tachiyomi.Chip.Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/inkshelf_quick_search_spiderman" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/popular_search_xmen"
                            style="@style/Widget.Tachiyomi.Chip.Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/inkshelf_quick_search_xmen" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/popular_search_horror"
                            style="@style/Widget.Tachiyomi.Chip.Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/inkshelf_quick_search_horror" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/popular_search_scifi"
                            style="@style/Widget.Tachiyomi.Chip.Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/inkshelf_quick_search_scifi" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/picked_for_you_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_12dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Chosen for You"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/picked_for_you_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/picked_for_you_banner_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:adjustViewBounds="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:rippleColor="?attr/colorPrimary"
                        app:strokeColor="#2A2A33"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/picked_for_you_banner_image"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:contentDescription="@string/inkshelf_pfy_see_all"
                                android:scaleType="fitCenter"
                                android:src="@drawable/inkshelf_pfy_discover_banner" />

                            <!-- Clear tap affordance without changing the existing whole-card click target. -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/picked_for_you_explore_picks_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="16dp"
                                android:layout_marginBottom="16dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                app:cardBackgroundColor="#D9000000"
                                app:cardCornerRadius="999dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E3B341"
                                app:strokeWidth="2dp">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="15dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="15dp"
                                    android:paddingBottom="8dp"
                                    android:text="Explore picks  →"
                                    android:textColor="#F4C85A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/trending_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/inkshelf_ic_trending_24dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Trending Now"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/trending_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trending_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="268dp"
                        android:layout_marginStart="-4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="-20dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingEnd="24dp"
                        android:visibility="gone"
                        tools:listitem="@layout/discover_recommendation_item" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/new_this_week_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_new_releases_outline_24dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="New This Week"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/new_this_week_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/new_this_week_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="268dp"
                        android:layout_marginStart="-4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="-20dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingEnd="24dp"
                        android:visibility="gone"
                        tools:listitem="@layout/discover_recommendation_item" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recently_updated_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_system_update_24dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Recently Updated"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/recently_updated_see_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="10dp"
                            android:text="@string/inkshelf_pfy_see_all"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/recently_updated_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recently_updated_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="268dp"
                        android:layout_marginStart="-4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="-20dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingEnd="24dp"
                        android:visibility="gone"
                        tools:listitem="@layout/discover_recommendation_item" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Kept for existing source-management internals, hidden from the modern Browse landing page. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/source_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:listitem="@layout/source_header_item" />

    </FrameLayout>

    <!-- Extensions and Migration remain available only through Manage Sources. -->
    <include
        android:id="@+id/bottom_sheet"
        layout="@layout/extensions_bottom_sheet" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
