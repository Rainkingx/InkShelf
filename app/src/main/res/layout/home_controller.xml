<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="?attr/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="104dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_hero_card"
            android:layout_width="match_parent"
            android:layout_height="356dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/inkshelf_home_hero_base">

                <ImageView
                    android:id="@+id/home_hero_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="1"
                    android:contentDescription="@string/cover_of_image" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/inkshelf_home_hero_fade"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/home_theme_kicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="THE COMIC PICK OF THE DAY"
                        android:textColor="#E7C5FF"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/home_theme_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-condensed"
                        android:text="MUTANT"
                        android:textColor="#FFFFFFFF"
                        android:shadowColor="#EE000000"
                        android:shadowDx="2"
                        android:shadowDy="3"
                        android:shadowRadius="8"
                        android:rotation="-3"
                        android:textStyle="bold|italic"
                        android:textSize="43sp" />

                    <TextView
                        android:id="@+id/home_theme_accent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="MONDAY"
                        android:textColor="#FFD524"
                        android:shadowColor="#D5000000"
                        android:shadowDx="2"
                        android:shadowDy="3"
                        android:shadowRadius="8"
                        android:rotation="-3"
                        android:textStyle="bold|italic"
                        android:textSize="47sp"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="29sp"
                        android:autoSizeMaxTextSize="47sp"
                        android:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/home_theme_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="2"
                        android:text="3 PICKS  •  New &amp; Trending  •  For You"
                        android:textColor="#F9F4FF"
                        android:textStyle="bold"
                        android:shadowColor="#D5000000"
                        android:shadowRadius="4"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_open_pick"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="▶  Read Now"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            app:backgroundTint="#B93EF2"
                            android:textColor="#FFFFFFFF"
                            app:cornerRadius="28dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_browse_button"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="+  Save"
                            android:textStyle="bold"
                            android:textColor="#FFFFFFFF"
                            android:textAllCaps="false"
                            app:strokeColor="#B973E5"
                            app:strokeWidth="1dp"
                            app:cornerRadius="28dp" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/home_hero_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Continue Reading"
                android:textColor="?attr/colorOnBackground"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/home_library_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="View all ›"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_continue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="Your recent reads will appear here."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_continue_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today's Picks"
                android:textColor="?attr/colorOnBackground"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/home_picks_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="See all ›"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_picks_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="Open Discover to load recommendations from your comic sources."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/home_picks_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>